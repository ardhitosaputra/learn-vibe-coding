# Database (Supabase PostgreSQL Connection String)
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI, Mode: Transaction / Port 6543)
# Contoh format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase API (Digunakan untuk Auth & Media Storage di Phase 3)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
